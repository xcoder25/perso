{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "A booking inquiry from a potential client.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of the person booking."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the person booking."
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "The date of the event."
        },
        "message": {
          "type": "string",
          "description": "Details about the event."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the booking was created."
        }
      },
      "required": ["name", "email", "date", "message", "createdAt"]
    }
  },
  "firestore": {
    "bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Collection of booking inquiries."
    }
  }
}
